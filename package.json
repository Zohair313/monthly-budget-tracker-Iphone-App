{
  "name": "monthly-budget-tracker-iphone-app",
  "private": true,
  "version": "1.0.0",
  "description": "Standalone 3D Claymorphism iPhone Budget Tracker workspace tooling",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"backend/src/**/*.js\" \"backend/api/**/*.js\" \"backend/tests/**/*.js\" \"mobile/src/**/*.js\" \"mobile/scripts/**/*.js\" \"mobile/App.js\"",
    "format:check": "prettier --check \"backend/src/**/*.js\" \"backend/api/**/*.js\" \"backend/tests/**/*.js\" \"mobile/src/**/*.js\" \"mobile/scripts/**/*.js\" \"mobile/App.js\"",
    "test:backend": "npm --prefix backend test",
    "build:pwa": "npm --prefix mobile run build:pwa"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
